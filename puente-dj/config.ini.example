# ============================================================
# Configuración del puente sikodark → RadioBOSS
# Copiá este archivo como config.ini y modificá los valores.
# ============================================================

[radioboss]
# Dirección de la API de RadioBOSS (corre en la misma PC del DJ).
# Puerto que figures en Settings -> Options -> API (normalmente 9000).
base_url = http://127.0.0.1:9000
# En RadioBOSS 6.x la API también suele exponerse bajo /api/.
# Si con "/" no responde, probá: path = /api/
path = /
password = CAMBIAR_POR_LA_CLAVE_DE_LA_API_DE_RADIOBOSS

# songrequest = usa la lista nativa "View -> Song Requests" y un evento
#               del programador con `playrequestedsong` reproduce los temas.
# inserttrack = inserta el tema directo en el playlist que está al aire.
modo = songrequest

# Solo para modo inserttrack. FIFO (orden de llegada) = -1 (al final):
#   -1 = al final del playlist (recomendado: respeta el pedido anterior)
#   -3 = después de los temas programados
#   -2 = después del tema actual (los nuevos quedan primeros, NO respeta orden)
insert_pos = -1

timeout = 6

[firestore]
# Archivo de service account de Firebase (Console -> Project settings ->
# Service accounts -> Generate new private key). NO lo subas al hosting.
service_account = serviceAccountKey.json
coleccion = temas_pedidos

[musica]
# Raíces donde están los MP3 (una por línea). En la captura: D:\Musica
raices = D:\Musica
         D:\OtraCarpetaSiLaHay
extensiones = .mp3,.m4a,.flac,.ogg,.wav
# Umbral de 0 a 100 para considerar que una canción coincide.
# Subilo si entra música equivocada; bajalo si no encuentra pedidos válidos.
umbral_score = 62

[puente]
# Segundos entre cada revisión de pedidos pendientes.
cada_seg = 8
# Segundos entre re-escaneos de la biblioteca (la música nueva se toma sola).
rescan_seg = 1800
# Intentos de match antes de marcar "no_encontrado" (reintenta en cada ciclo).
max_intentos = 3
# Marcar automáticamente un pedido como "sonado" cuando aparece en
# el historial de reproducción de RadioBOSS.
marcar_sonado = yes
